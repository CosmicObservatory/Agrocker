# Clave de WeatherAPI (https://www.weatherapi.com/)
WEATHERAPI_KEY=

# Primer anio de historia climatica a descargar
WEATHER_START_YEAR=2010
# Tamano de chunk en dias para la API de historial
WEATHER_CHUNK_DAYS=18
# Limitar puntos de muestreo (0 = todos los estados)
WEATHER_MAX_POINTS=0
# Segundos entre peticiones a la API del clima
WEATHER_RATE_LIMIT_SECONDS=0.5

# URL base de los CSV de produccion DGSIAP (si se dejan vacias se
# intenta descubrir desde la pagina de datos abiertos)
SIAP_BASE_URL=
SIAP_LOCAL_DIR=

# Token opcional para API de precios queprecio.info
QUEPRECIO_TOKEN=

# Horas entre corridas del pipeline en modo programado (0 = one-shot)
PIPELINE_INTERVAL_HOURS=0

# Directorio de bases de datos
DB_DIR=/app/data
